# Configuration of docker-compose.yml. In Dokploy, paste it in the Environment tab.
# Every variable: docs/CONFIGURATION.md

# Required
LIKA_WEB_URL=https://lika.example.com
# openssl rand -base64 48
LIKA_SESSION_SECRET=

# Recommended
# Public URL of the short link domain served by the API: gives the MCP URL
LIKA_PUBLIC_API_URL=https://go.example.com
# openssl rand -base64 48. Without it, a random one is drawn at each start.
LIKA_JWT_SECRET=
# Fixed token to create the first admin; otherwise a random one is printed in the API logs
LIKA_SETUP_TOKEN=

# Database: sqlite (file in the lika-data volume) or mongo
LIKA_DB=sqlite
DB_MONGODB_CONNSTRING=
DB_MONGODB_APPDATABASE=lika

# Sign-in: local, keycloak or firebase
LIKA_AUTH_PROVIDER=local
LIKA_KEYCLOAK_URL=
LIKA_KEYCLOAK_REALM=
LIKA_KEYCLOAK_CLIENT_ID=
LIKA_KEYCLOAK_CLIENT_SECRET=
LIKA_FIREBASE_PROJECT_ID=
LIKA_FIREBASE_API_KEY=
# The JSON of the service account key, on one line
LIKA_FIREBASE_SERVICE_ACCOUNT=
LIKA_FIREBASE_GOOGLE_CLIENT_ID=
LIKA_FIREBASE_GOOGLE_CLIENT_SECRET=

# Emails (Mailjet)
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAIL_FROM=
