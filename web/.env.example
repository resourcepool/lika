# Lika web interface: environment variables. In Dokploy: Environment tab of the web application.
# Every variable is described in docs/CONFIGURATION.md.

# --- Required

# URL of the API as this container reaches it. In Dokploy: http://<App Name of the API application>:8080
# (internal network), or its public URL, e.g. https://go.example.com
LIKA_API_URL=http://lika-api:8080
# Encrypts the session cookies, 32+ random characters: openssl rand -base64 48
# Changing it signs everyone out.
LIKA_SESSION_SECRET=
