# Lika API: environment variables. In Dokploy: Environment tab of the API application.
# Every variable is described in docs/CONFIGURATION.md.
#
# The database is chosen when building the image: build argument DB=sqlite (default), postgres or mongo
# (Dokploy: Environment › Build Time Arguments).

# --- Required

# Public URL of the web interface: links of invitations and password resets
LIKA_WEB_URL=https://lika.example.com

# --- Recommended

# Public URL of the API, i.e. of a short link domain: gives the URL of the MCP server
LIKA_PUBLIC_API_URL=https://go.example.com
# Signs the access tokens (local sign-in), 32+ characters: openssl rand -base64 48
# Without it, a new one is drawn at each start.
LIKA_JWT_SECRET=
# Fixed token creating the first admin; without it, a random one is printed in the logs
LIKA_SETUP_TOKEN=

# --- Database (matching the DB build argument)

# DB=sqlite: file of the database. Mount a volume on /data.
DB_SQLITE_PATH=/data/lika.db
# DB=postgres: JDBC URL, or postgresql://user:password@host:5432/lika (Dokploy: Internal Connection URL of the database)
DB_POSTGRES_URL=
# DB=mongo
DB_MONGODB_CONNSTRING=
DB_MONGODB_APPDATABASE=lika

# --- Sign-in: local (default), keycloak or firebase

LIKA_AUTH_PROVIDER=local
# keycloak
LIKA_KEYCLOAK_URL=
LIKA_KEYCLOAK_REALM=
LIKA_KEYCLOAK_CLIENT_ID=
LIKA_KEYCLOAK_CLIENT_SECRET=
LIKA_KEYCLOAK_LABEL=Keycloak
# firebase
LIKA_FIREBASE_PROJECT_ID=
LIKA_FIREBASE_API_KEY=
# JSON of the service account key, on one line, or the path to its file
LIKA_FIREBASE_SERVICE_ACCOUNT=
# Optional, enables "Sign in with Google"
LIKA_FIREBASE_GOOGLE_CLIENT_ID=
LIKA_FIREBASE_GOOGLE_CLIENT_SECRET=

# --- Emails (Mailjet). Without them, invitation and reset links are shown to admins.

MAILJET_API_KEY=
MAILJET_API_SECRET=
MAIL_FROM=
MAIL_FROM_NAME=Lika

# --- MCP server: origins of browser-based MCP clients, comma-separated, or *
LIKA_MCP_ALLOWED_ORIGINS=

# --- JVM
JAVA_OPTS=-XX:MaxRAMPercentage=75
